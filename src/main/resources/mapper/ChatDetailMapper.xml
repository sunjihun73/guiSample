<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.jihun.guisample.mapper.ChatDetailMapper">

    <resultMap id="chatDetailResultMap" type="kr.co.jihun.guisample.dto.ChatDetailDTO">
        <id     property="chatContentId"      column="chat_content_id"/>
        <result property="chatSessionId"      column="chat_session_id"/>
        <result property="chatContent"        column="chat_content"/>
        <result property="role"               column="role"/>
        <result property="model"              column="model"/>
        <result property="promptTokens"       column="prompt_tokens"/>
        <result property="completionTokens"   column="completion_tokens"/>
        <result property="updateUserId"       column="update_user_id"/>
        <result property="updateDate"         column="update_date"/>
        <result property="createUserId"       column="create_user_id"/>
        <result property="createDate"         column="create_date"/>
    </resultMap>

    <sql id="chatDetailColumns">
        chat_content_id,
        chat_session_id,
        chat_content,
        role,
        model,
        prompt_tokens,
        completion_tokens,
        update_user_id,
        update_date,
        create_user_id,
        create_date
    </sql>

    <insert id="insertChatDetail" parameterType="kr.co.jihun.guisample.dto.ChatDetailDTO">
        INSERT INTO chat_detail (
            chat_session_id,
            chat_content,
            role,
            model,
            prompt_tokens,
            completion_tokens,
            create_user_id,
            create_date,
            update_user_id,
            update_date
        ) VALUES (
            #{chatSessionId},
            #{chatContent},
            #{role},
            #{model},
            #{promptTokens},
            #{completionTokens},
            #{createUserId},
            NOW(),
            #{updateUserId},
            NOW()
        )
    </insert>

    <select id="selectChatDetailList"
            resultMap="chatDetailResultMap">
        SELECT
            <include refid="chatDetailColumns"/>
        FROM
            chat_detail
        WHERE
            chat_session_id = #{sessionId}
        ORDER BY chat_content_id ASC
    </select>

</mapper>
